scoreboard players operation math1 wardenrw.math.temp = @s wardenrw.mp
scoreboard players set math2 wardenrw.math.temp 100
scoreboard players operation math1 wardenrw.math.temp *= math2 wardenrw.math.temp
scoreboard players operation math1 wardenrw.math.temp /= @s wardenrw.max_mp

execute if score math1 wardenrw.math.temp matches 100 run title @s actionbar [{text:"MP ",bold:true,color:"dark_blue"},{text:"|■■■■■■■■■■■| ",color:"blue"},{score:{name:"@s",objective:"wardenrw.mp"},color:"blue"},{text:"/",color:"dark_blue"},{score:{name:"@s",objective:"wardenrw.max_mp"},color:"blue"}]
